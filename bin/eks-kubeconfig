#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml>=6.0"]
# ///
"""Bulk-manage EKS entries in a kubeconfig from a YAML config file.

Replaces long chains of `aws eks update-kubeconfig --profile ... --name ...
--alias ...` with a declarative file:

    clusters:
      - name: gamma-gitops-hub        # EKS cluster name
        profile: auto:admin           # AWS profile
        contexts:                     # kube contexts to create for it
          - gitops
          - {name: gitops-hub, namespace: argocd}

Subcommands:
  status    report whether each configured context exists, matches the config,
            and (with --probe) answers on the API server
  sync      make the kubeconfig match the config; --dry-run shows a diff
  discover  list EKS clusters reachable from your AWS profiles that the config
            does not mention yet, as a paste-ready YAML snippet

How `sync` works: `aws eks update-kubeconfig` is still the source of truth for
the cluster/exec-credential blocks -- one call per unique (profile, region,
cluster), run in parallel into throwaway kubeconfigs. This tool then merges
those blocks into the real kubeconfig, so it can fan several named contexts off
one cluster and write the file once, atomically, with a backup.

Every entry `sync` writes is stamped with an `extensions` marker naming this
tool. That is what makes the config authoritative: rename or delete a context in
the config and the next `sync` offers to remove the stale one, while contexts
you created by hand are never touched. `--prune-untracked` widens the sweep to
unmarked EKS contexts; `--no-prune` disables removal entirely.

kubectl round-trips those markers (`config view`, `set-context`, `use-context`
all preserve them), but a bare `aws eks update-kubeconfig` against a cluster
replaces its entries outright and drops the marker. That self-heals on the next
`sync` for anything still listed in the config.

Merging rewrites the whole kubeconfig through a YAML round-trip, so the first
run normalises formatting and drops any comments. Use --dry-run first.

Requires the `aws` CLI on PATH; `kubectl` only for `status --probe`.
"""

from __future__ import annotations

import argparse
import configparser
import difflib
import fnmatch
import json
import os
import re
import subprocess
import sys
import tempfile
from collections.abc import Iterable, Sequence
from concurrent import futures
from dataclasses import dataclass
from pathlib import Path
from typing import Any

import yaml

PROG = "eks-kubeconfig"

XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / PROG / "clusters.yaml"

# Preference order for picking one profile per AWS account during `discover`.
ROLE_PREFERENCE = ("admin", "poweruser", "power", "eng", "engineer", "readonly", "read")

EXIT_OK = 0
EXIT_PROBLEM = 1
EXIT_ERROR = 2


# --------------------------------------------------------------------------- output


_COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ


def _sgr(code: str, text: str) -> str:
    return f"\033[{code}m{text}\033[0m" if _COLOR else text


def green(t: str) -> str:
    return _sgr("32", t)


def red(t: str) -> str:
    return _sgr("31", t)


def yellow(t: str) -> str:
    return _sgr("33", t)


def blue(t: str) -> str:
    return _sgr("34", t)


def dim(t: str) -> str:
    return _sgr("2", t)


def bold(t: str) -> str:
    return _sgr("1", t)


def warn(msg: str) -> None:
    print(f"{PROG}: warning: {msg}", file=sys.stderr)


def die(msg: str) -> None:
    print(f"{PROG}: {msg}", file=sys.stderr)
    raise SystemExit(EXIT_ERROR)


class ConfigError(Exception):
    pass


# --------------------------------------------------------------------------- config


@dataclass(frozen=True)
class ContextSpec:
    name: str
    namespace: str | None = None


@dataclass(frozen=True)
class Cluster:
    name: str
    profile: str
    region: str
    contexts: tuple[ContextSpec, ...]
    role_arn: str | None = None

    @property
    def key(self) -> tuple[str, str, str]:
        """Identity of the underlying `aws eks update-kubeconfig` call."""
        return (self.profile, self.region, self.name)

    @property
    def label(self) -> str:
        return f"{self.profile}/{self.name}"


@dataclass
class Config:
    path: Path
    clusters: list[Cluster]
    kubeconfig: Path | None
    discover_profiles: list[str]
    discover_regions: list[str]
    discover_exclude: list[str]


def find_config(explicit: Path | None) -> Path:
    candidates = []
    if explicit:
        candidates = [explicit]
    elif env := os.environ.get("EKS_KUBECONFIG_CONFIG"):
        candidates = [Path(env).expanduser()]
    else:
        candidates = [XDG_CONFIG]
    for candidate in candidates:
        if candidate.is_file():
            return candidate
    tried = ", ".join(str(c) for c in candidates)
    die(f"no config file found (tried: {tried})")
    raise AssertionError  # unreachable


def _context_specs(raw: Any, cluster_name: str, where: str) -> tuple[ContextSpec, ...]:
    if raw is None:
        return (ContextSpec(cluster_name),)
    if isinstance(raw, (str, dict)):
        raw = [raw]
    if not isinstance(raw, list):
        raise ConfigError(f"{where}: `contexts` must be a string, mapping, or list")
    specs = []
    for item in raw:
        if isinstance(item, str):
            specs.append(ContextSpec(item))
        elif isinstance(item, dict):
            name = item.get("name") or item.get("context")
            if not name:
                raise ConfigError(f"{where}: context entry needs a `name`")
            specs.append(ContextSpec(str(name), item.get("namespace")))
        else:
            raise ConfigError(f"{where}: bad context entry {item!r}")
    return tuple(specs)


def load_config(path: Path) -> Config:
    try:
        data = yaml.safe_load(path.read_text()) or {}
    except yaml.YAMLError as exc:
        raise ConfigError(f"{path}: {exc}") from exc
    if not isinstance(data, dict):
        raise ConfigError(f"{path}: top level must be a mapping")

    defaults = data.get("defaults") or {}
    default_region = defaults.get("region")
    default_profile = defaults.get("profile")
    kubeconfig = defaults.get("kubeconfig")

    clusters: list[Cluster] = []
    for i, raw in enumerate(data.get("clusters") or []):
        where = f"{path}: clusters[{i}]"
        if not isinstance(raw, dict):
            raise ConfigError(f"{where}: must be a mapping")
        if raw.get("enabled") is False:
            continue
        name = raw.get("name") or raw.get("cluster")
        if not name:
            raise ConfigError(f"{where}: missing `name`")
        profile = raw.get("profile") or default_profile
        if not profile:
            raise ConfigError(f"{where} ({name}): missing `profile` and no defaults.profile")
        region = raw.get("region") or default_region
        if not region:
            raise ConfigError(f"{where} ({name}): missing `region` and no defaults.region")
        contexts = _context_specs(raw.get("contexts", raw.get("context")), str(name), f"{where} ({name})")
        clusters.append(
            Cluster(
                name=str(name),
                profile=str(profile),
                region=str(region),
                contexts=contexts,
                role_arn=raw.get("role_arn"),
            )
        )

    seen: dict[str, str] = {}
    for cluster in clusters:
        for spec in cluster.contexts:
            if spec.name in seen:
                raise ConfigError(f"{path}: context {spec.name!r} declared twice ({seen[spec.name]}, {cluster.label})")
            seen[spec.name] = cluster.label

    disc = data.get("discover") or {}
    return Config(
        path=path,
        clusters=clusters,
        kubeconfig=Path(str(kubeconfig)).expanduser() if kubeconfig else None,
        discover_profiles=[str(p) for p in (disc.get("profiles") or [])],
        discover_regions=[str(r) for r in (disc.get("regions") or ([default_region] if default_region else []))],
        discover_exclude=[str(e) for e in (disc.get("exclude") or [])],
    )


def select(clusters: Sequence[Cluster], selectors: Sequence[str], profiles: Sequence[str]) -> list[Cluster]:
    """Filter by glob against cluster names / context names, and by profile glob."""
    out = list(clusters)
    if selectors:
        out = [
            c
            for c in out
            if any(
                fnmatch.fnmatch(c.name, s) or any(fnmatch.fnmatch(ctx.name, s) for ctx in c.contexts)
                for s in selectors
            )
        ]
    if profiles:
        out = [c for c in out if any(fnmatch.fnmatch(c.profile, s) for s in profiles)]
    return out


# --------------------------------------------------------------------------- aws cli


class AwsError(Exception):
    def __init__(self, message: str, needs_login: bool = False) -> None:
        super().__init__(message)
        self.needs_login = needs_login


_SSO_EXPIRED = re.compile(
    r"(sso session .*(expired|invalid))|(token has expired)|(ExpiredToken)|(refresh failed)"
    r"|(sso-session .*expired)|(Error loading SSO Token)",
    re.IGNORECASE,
)


def _error_line(stderr: str) -> str:
    """Pull the human-meaningful line out of a multi-line aws CLI error."""
    lines = [line.strip() for line in stderr.splitlines() if line.strip()]
    if not lines:
        return ""
    for line in lines:
        if "An error occurred" in line or "[ERROR]" in line or line.lower().startswith("error"):
            return re.sub(r"^aws: \[ERROR\]:\s*", "", line)
    return lines[-1]


def run_aws(args: list[str], timeout: int = 90) -> str:
    env = {**os.environ, "AWS_PAGER": ""}
    try:
        proc = subprocess.run(
            ["aws", *args], capture_output=True, text=True, env=env, timeout=timeout, check=False
        )
    except FileNotFoundError:
        raise AwsError("`aws` CLI not found on PATH") from None
    except subprocess.TimeoutExpired:
        raise AwsError(f"timed out after {timeout}s") from None
    if proc.returncode != 0:
        stderr = proc.stderr.strip() or proc.stdout.strip() or f"exit {proc.returncode}"
        raise AwsError(_error_line(stderr) or stderr, needs_login=bool(_SSO_EXPIRED.search(stderr)))
    return proc.stdout


def aws_profiles(path: Path | None = None) -> dict[str, dict[str, str]]:
    """Parse ~/.aws/config into {profile_name: {setting: value}}."""
    path = path or Path(os.environ.get("AWS_CONFIG_FILE", Path.home() / ".aws" / "config")).expanduser()
    if not path.is_file():
        return {}
    parser = configparser.ConfigParser()
    try:
        parser.read(path)
    except configparser.Error as exc:
        warn(f"{path}: {exc}")
        return {}
    profiles: dict[str, dict[str, str]] = {}
    for section in parser.sections():
        if section == "default":
            name = "default"
        elif section.startswith("profile "):
            name = section[len("profile ") :].strip()
        else:
            continue
        profiles[name] = dict(parser[section])
    return profiles


def profile_account(settings: dict[str, str]) -> str | None:
    if account := settings.get("sso_account_id"):
        return account
    if role_arn := settings.get("role_arn"):
        parts = role_arn.split(":")
        if len(parts) > 4:
            return parts[4]
    return None


def profile_rank(name: str) -> int:
    tail = name.rsplit(":", 1)[-1].rsplit("-", 1)[-1].lower()
    for i, role in enumerate(ROLE_PREFERENCE):
        if tail == role:
            return i
    for i, role in enumerate(ROLE_PREFERENCE):
        if role in name.lower():
            return len(ROLE_PREFERENCE) + i
    return 2 * len(ROLE_PREFERENCE)


def sso_login_hint(profiles: Iterable[str], settings: dict[str, dict[str, str]]) -> str:
    sessions = {settings.get(p, {}).get("sso_session") for p in profiles}
    sessions.discard(None)
    if len(sessions) == 1:
        return f"aws sso login --sso-session {sessions.pop()}"
    first = min(profiles)
    return f"aws sso login --profile {first}"


# --------------------------------------------------------------------------- kubeconfig


def resolve_kubeconfig(cli: Path | None, config: Config) -> Path:
    if cli:
        return cli.expanduser()
    if config.kubeconfig:
        return config.kubeconfig
    if env := os.environ.get("KUBECONFIG"):
        parts = [p for p in env.split(os.pathsep) if p]
        if len(parts) > 1:
            warn(f"KUBECONFIG lists {len(parts)} files; using the first ({parts[0]})")
        if parts:
            return Path(parts[0]).expanduser()
    return Path.home() / ".kube" / "config"


def load_kubeconfig(path: Path) -> dict[str, Any]:
    if not path.is_file():
        return {"apiVersion": "v1", "kind": "Config", "preferences": {}, "clusters": [], "contexts": [], "users": []}
    doc = yaml.safe_load(path.read_text()) or {}
    if not isinstance(doc, dict):
        die(f"{path}: not a kubeconfig mapping")
    doc.setdefault("apiVersion", "v1")
    doc.setdefault("kind", "Config")
    for key in ("clusters", "contexts", "users"):
        if not isinstance(doc.get(key), list):
            doc[key] = []
    return doc


class NoAliasDumper(yaml.SafeDumper):
    """Never emit &anchors/*aliases -- a kubeconfig should be flat and greppable."""

    def ignore_aliases(self, data: Any) -> bool:
        return True


def dump_kubeconfig(doc: dict[str, Any]) -> str:
    return yaml.dump(doc, Dumper=NoAliasDumper, default_flow_style=False, sort_keys=True, width=4096)


def write_kubeconfig(path: Path, doc: dict[str, Any], backup: bool) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    if backup and path.is_file():
        backup_path = path.with_suffix(path.suffix + ".bak")
        backup_path.write_bytes(path.read_bytes())
        os.chmod(backup_path, 0o600)
    mode = path.stat().st_mode & 0o777 if path.is_file() else 0o600
    fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(dump_kubeconfig(doc))
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def by_name(items: Sequence[dict[str, Any]], name: str) -> dict[str, Any] | None:
    return next((item for item in items if item.get("name") == name), None)


def upsert(items: list[dict[str, Any]], entry: dict[str, Any]) -> bool:
    """Replace the entry with a matching `name`, or append it. True if changed."""
    for i, item in enumerate(items):
        if item.get("name") == entry["name"]:
            if item == entry:
                return False
            items[i] = entry
            return True
    items.append(entry)
    return True


def exec_profile(user_entry: dict[str, Any] | None) -> str | None:
    exec_block = ((user_entry or {}).get("user") or {}).get("exec") or {}
    for var in exec_block.get("env") or []:
        if var.get("name") == "AWS_PROFILE":
            return var.get("value")
    return None


def is_eks_user(user_entry: dict[str, Any]) -> bool:
    exec_block = (user_entry.get("user") or {}).get("exec") or {}
    return "eks" in (exec_block.get("args") or []) and "get-token" in (exec_block.get("args") or [])


EKS_ARN = re.compile(r"^arn:aws[\w-]*:eks:")


# kubeconfig cluster/user/context bodies each carry an `extensions` list that
# kubectl round-trips untouched (verified against `config view`, `set-context`
# and `use-context`). Stamping ours there is how a later `sync` knows which
# entries it owns -- so a context renamed or dropped in the config gets removed,
# while anything you created by hand is left alone.
def add_marker(body: dict[str, Any]) -> dict[str, Any]:
    others = [e for e in (body.get("extensions") or []) if e.get("name") != PROG]
    # Build a fresh dict per call; a shared one makes PyYAML emit &anchors/*aliases.
    body["extensions"] = [*others, {"name": PROG, "extension": {"managed-by": PROG}}]
    return body


def has_marker(body: dict[str, Any] | None) -> bool:
    return any(e.get("name") == PROG for e in ((body or {}).get("extensions") or []))


def plan_prune(doc: dict[str, Any], keep: set[str], untracked: bool) -> list[str]:
    """Name the contexts a prune would remove. Pure -- does not touch `doc`."""
    doomed = []
    for entry in doc["contexts"]:
        name = entry.get("name", "")
        if name in keep:
            continue
        if has_marker(entry.get("context")):
            doomed.append(name)  # we created it; the config no longer lists it
        elif untracked:
            user = by_name(doc["users"], (entry.get("context") or {}).get("user", ""))
            if user is not None and is_eks_user(user):
                doomed.append(name)
    return doomed


def apply_prune(doc: dict[str, Any], doomed: Sequence[str]) -> None:
    """Remove the named contexts plus any cluster/user entries they orphaned."""
    current = doc.get("current-context")
    current_cluster = ((by_name(doc["contexts"], current or "") or {}).get("context") or {}).get("cluster")

    survivors = [e for e in doc["contexts"] if e.get("name") not in set(doomed)]
    doc["contexts"] = survivors

    referenced_clusters = {(e.get("context") or {}).get("cluster") for e in survivors}
    referenced_users = {(e.get("context") or {}).get("user") for e in survivors}
    doc["clusters"] = [
        c
        for c in doc["clusters"]
        if c.get("name") in referenced_clusters
        or not (has_marker(c.get("cluster")) or EKS_ARN.match(c.get("name", "")))
    ]
    doc["users"] = [
        u for u in doc["users"] if u.get("name") in referenced_users or not (has_marker(u.get("user")) or is_eks_user(u))
    ]

    if current in doomed:
        # Re-point at a surviving context on the same cluster rather than
        # leaving the user with no current context at all.
        replacement = next(
            (
                e["name"]
                for e in survivors
                if (e.get("context") or {}).get("cluster") == current_cluster
                and not (e.get("context") or {}).get("namespace")
            ),
            None,
        )
        if replacement:
            warn(f"current context was pruned; switching to {replacement}")
            doc["current-context"] = replacement
        else:
            warn(f"current context {current!r} was pruned with no equivalent; unsetting it")
            doc.pop("current-context", None)


def confirm(question: str) -> bool:
    if not sys.stdin.isatty():
        return False
    try:
        return input(f"{question} [y/N] ").strip().lower() in {"y", "yes"}
    except EOFError:
        return False


# --------------------------------------------------------------------------- fetch


@dataclass
class Fetched:
    cluster: Cluster
    arn: str
    cluster_entry: dict[str, Any]
    user_entry: dict[str, Any]


def fetch_cluster(cluster: Cluster) -> Fetched:
    """Run `aws eks update-kubeconfig` into a scratch file and lift the blocks out."""
    with tempfile.TemporaryDirectory(prefix=f"{PROG}-") as tmpdir:
        scratch = Path(tmpdir) / "kubeconfig"
        args = [
            "eks",
            "update-kubeconfig",
            "--name",
            cluster.name,
            "--region",
            cluster.region,
            "--profile",
            cluster.profile,
            "--kubeconfig",
            str(scratch),
        ]
        if cluster.role_arn:
            args += ["--role-arn", cluster.role_arn]
        run_aws(args)
        doc = yaml.safe_load(scratch.read_text()) or {}

    entries = doc.get("clusters") or []
    users = doc.get("users") or []
    if not entries or not users:
        raise AwsError("aws eks update-kubeconfig produced no cluster entry")
    cluster_entry = entries[0]
    user_entry = users[0]
    arn = cluster_entry["name"]

    # Force AWS_PROFILE even if a future CLI stops emitting it.
    exec_block = user_entry.setdefault("user", {}).setdefault("exec", {})
    env = [e for e in (exec_block.get("env") or []) if e.get("name") != "AWS_PROFILE"]
    env.append({"name": "AWS_PROFILE", "value": cluster.profile})
    exec_block["env"] = env
    return Fetched(cluster=cluster, arn=arn, cluster_entry=cluster_entry, user_entry=user_entry)


def user_keys(clusters: Sequence[Cluster], arn_of: dict[tuple[str, str, str], str]) -> dict[tuple[str, str, str], str]:
    """Name the kubeconfig user per cluster: the bare ARN, or ARN#profile on collision."""
    profiles_per_arn: dict[str, set[str]] = {}
    for cluster in clusters:
        arn = arn_of.get(cluster.key)
        if arn:
            profiles_per_arn.setdefault(arn, set()).add(cluster.profile)
    keys = {}
    for cluster in clusters:
        arn = arn_of.get(cluster.key)
        if not arn:
            continue
        keys[cluster.key] = arn if len(profiles_per_arn[arn]) == 1 else f"{arn}#{cluster.profile}"
    return keys


# --------------------------------------------------------------------------- sync


def cmd_sync(args: argparse.Namespace, config: Config) -> int:
    clusters = select(config.clusters, args.selector, args.profile)
    if not clusters:
        die("no clusters matched")
    kubeconfig = resolve_kubeconfig(args.kubeconfig, config)

    # Pruning compares the kubeconfig against the *whole* config, so a filtered
    # run would read every unselected context as deleted.
    pruning = args.prune and not (args.selector or args.profile)
    if args.prune and not pruning:
        print(f"{dim('prune skipped: filtered run')}", file=sys.stderr)

    unique: dict[tuple[str, str, str], Cluster] = {}
    for cluster in clusters:
        unique.setdefault(cluster.key, cluster)

    print(f"{bold('syncing')} {len(clusters)} cluster(s) into {kubeconfig}", file=sys.stderr)

    fetched: dict[tuple[str, str, str], Fetched] = {}
    failures: list[tuple[Cluster, AwsError]] = []
    with futures.ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool:
        pending = {pool.submit(fetch_cluster, c): c for c in unique.values()}
        for future in futures.as_completed(pending):
            cluster = pending[future]
            try:
                result = future.result()
            except AwsError as exc:
                failures.append((cluster, exc))
                print(f"  {red('✗')} {cluster.label}: {exc}", file=sys.stderr)
                continue
            fetched[cluster.key] = result
            print(f"  {green('✓')} {cluster.label}", file=sys.stderr)

    if not fetched:
        report_failures(failures)
        return EXIT_PROBLEM

    doc = load_kubeconfig(kubeconfig)
    before = dump_kubeconfig(doc)
    keys = user_keys(clusters, {key: f.arn for key, f in fetched.items()})

    changed: list[str] = []
    for cluster in clusters:
        result = fetched.get(cluster.key)
        if not result:
            continue
        user_name = keys[cluster.key]
        upsert(doc["clusters"], {"name": result.arn, "cluster": add_marker(result.cluster_entry["cluster"])})
        upsert(doc["users"], {"name": user_name, "user": add_marker(result.user_entry["user"])})
        for spec in cluster.contexts:
            context: dict[str, Any] = {"cluster": result.arn, "user": user_name}
            if spec.namespace:
                context["namespace"] = spec.namespace
            if upsert(doc["contexts"], {"name": spec.name, "context": add_marker(context)}):
                changed.append(spec.name)

    pruned: list[str] = []
    if pruning:
        if failures:
            warn("skipping prune: some clusters failed to refresh, so the config is not fully applied")
        else:
            keep = {spec.name for cluster in clusters for spec in cluster.contexts}
            pruned = prune_kubeconfig_interactive(doc, keep, args)

    if args.set_current:
        if by_name(doc["contexts"], args.set_current) is None:
            die(f"--set-current {args.set_current!r}: no such context after sync")
        doc["current-context"] = args.set_current
    doc.setdefault("preferences", {})

    after = dump_kubeconfig(doc)
    if before == after:
        print(f"{dim('no changes')} ({kubeconfig})", file=sys.stderr)
        report_failures(failures)
        return EXIT_PROBLEM if failures else EXIT_OK

    if args.dry_run:
        diff = difflib.unified_diff(
            before.splitlines(keepends=True),
            after.splitlines(keepends=True),
            fromfile=f"{kubeconfig} (normalised)",
            tofile=f"{kubeconfig} (proposed)",
        )
        sys.stdout.writelines(colorize_diff(diff))
        if pruned:
            print(f"{yellow('would prune')}: {', '.join(sorted(pruned))}", file=sys.stderr)
        print(f"{yellow('dry run')}: nothing written", file=sys.stderr)
    else:
        write_kubeconfig(kubeconfig, doc, backup=args.backup)
        suffix = f" (backup: {kubeconfig.name}.bak)" if args.backup else ""
        print(f"{green('wrote')} {kubeconfig}{suffix}", file=sys.stderr)
        if changed:
            print(f"  contexts touched: {', '.join(sorted(set(changed)))}", file=sys.stderr)
        if pruned:
            print(f"  contexts pruned:  {', '.join(sorted(pruned))}", file=sys.stderr)

    report_failures(failures)
    return EXIT_PROBLEM if failures else EXIT_OK


def prune_kubeconfig_interactive(doc: dict[str, Any], keep: set[str], args: argparse.Namespace) -> list[str]:
    """Show what a prune would remove, get a yes, then do it."""
    doomed = plan_prune(doc, keep, untracked=args.prune_untracked)
    if not doomed:
        return []

    managed = [n for n in doomed if has_marker((by_name(doc["contexts"], n) or {}).get("context"))]
    print(f"\n{bold('contexts to remove')} ({len(doomed)}):", file=sys.stderr)
    for name in sorted(doomed):
        tag = dim("managed by this tool") if name in managed else yellow("untracked EKS context")
        print(f"  {red('-')} {name}  {tag}", file=sys.stderr)

    if args.dry_run:
        apply_prune(doc, doomed)  # so the diff shows the removals too
        return doomed
    if not args.yes and not confirm(f"{bold('remove')} {len(doomed)} context(s)?"):
        print(f"{dim('prune skipped')}", file=sys.stderr)
        return []

    apply_prune(doc, doomed)
    return doomed


def colorize_diff(lines: Iterable[str]) -> Iterable[str]:
    for line in lines:
        if line.startswith("+") and not line.startswith("+++"):
            yield green(line.rstrip("\n")) + "\n"
        elif line.startswith("-") and not line.startswith("---"):
            yield red(line.rstrip("\n")) + "\n"
        elif line.startswith("@@"):
            yield blue(line.rstrip("\n")) + "\n"
        else:
            yield line


def report_failures(failures: Sequence[tuple[Cluster, AwsError]]) -> None:
    if not failures:
        return
    expired = [c.profile for c, exc in failures if exc.needs_login]
    if expired:
        settings = aws_profiles()
        print(f"\n{yellow('login required')}: {sso_login_hint(set(expired), settings)}", file=sys.stderr)


# --------------------------------------------------------------------------- status


@dataclass
class Status:
    cluster: Cluster
    context: ContextSpec
    state: str  # ok | missing | stale
    notes: list[str]
    probe: str | None = None
    probe_detail: str | None = None


def probe_context(kubeconfig: Path, context: str, timeout: int) -> tuple[str, str | None]:
    cmd = [
        "kubectl",
        "--kubeconfig",
        str(kubeconfig),
        "--context",
        context,
        f"--request-timeout={timeout}s",
        "get",
        "--raw",
        "/version",
    ]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout + 15, check=False)
    except FileNotFoundError:
        return "skipped", "kubectl not found"
    except subprocess.TimeoutExpired:
        return "timeout", f">{timeout}s"
    if proc.returncode == 0:
        try:
            version = json.loads(proc.stdout)
            return "up", f"v{version.get('gitVersion', '?').lstrip('v')}"
        except json.JSONDecodeError:
            return "up", None
    stderr = proc.stderr.strip()
    if _SSO_EXPIRED.search(stderr):
        return "auth", "sso login required"
    if "forbidden" in stderr.lower() or "Unauthorized" in stderr:
        return "auth", "not authorized"
    first = stderr.splitlines()[0] if stderr else f"exit {proc.returncode}"
    return "down", first[:80]


def cmd_status(args: argparse.Namespace, config: Config) -> int:
    clusters = select(config.clusters, args.selector, args.profile)
    kubeconfig = resolve_kubeconfig(args.kubeconfig, config)
    doc = load_kubeconfig(kubeconfig)

    results: list[Status] = []
    tracked: set[str] = set()
    for cluster in clusters:
        for spec in cluster.contexts:
            tracked.add(spec.name)
            results.append(check_context(doc, cluster, spec))

    if args.probe:
        probeable = [r for r in results if r.state != "missing"]
        with futures.ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool:
            pending = {
                pool.submit(probe_context, kubeconfig, r.context.name, args.timeout): r for r in probeable
            }
            for future in futures.as_completed(pending):
                result = pending[future]
                result.probe, result.probe_detail = future.result()

    if args.json:
        print(json.dumps([status_json(r) for r in results], indent=2))
    else:
        print_status_table(results, kubeconfig, doc, tracked, args)

    return EXIT_PROBLEM if any(r.state != "ok" or r.probe in {"down", "auth", "timeout"} for r in results) else EXIT_OK


def check_context(doc: dict[str, Any], cluster: Cluster, spec: ContextSpec) -> Status:
    entry = by_name(doc["contexts"], spec.name)
    if entry is None:
        return Status(cluster, spec, "missing", ["context not in kubeconfig"])

    notes: list[str] = []
    context = entry.get("context") or {}
    cluster_ref = context.get("cluster", "")
    cluster_entry = by_name(doc["clusters"], cluster_ref)
    if cluster_entry is None:
        notes.append(f"cluster {cluster_ref!r} not defined")
    if cluster_ref.rsplit("/", 1)[-1] != cluster.name:
        notes.append(f"points at {cluster_ref.rsplit('/', 1)[-1] or '?'!r}, want {cluster.name!r}")
    if f":{cluster.region}:" not in cluster_ref:
        notes.append(f"region mismatch (want {cluster.region})")

    user_entry = by_name(doc["users"], context.get("user", ""))
    if user_entry is None:
        notes.append(f"user {context.get('user', '')!r} not defined")
    else:
        found = exec_profile(user_entry)
        if found != cluster.profile:
            notes.append(f"profile {found or 'none'!r}, want {cluster.profile!r}")

    if (context.get("namespace") or None) != (spec.namespace or None):
        notes.append(f"namespace {context.get('namespace') or 'default'!r}, want {spec.namespace or 'default'!r}")

    return Status(cluster, spec, "ok" if not notes else "stale", notes)


def status_json(result: Status) -> dict[str, Any]:
    return {
        "context": result.context.name,
        "cluster": result.cluster.name,
        "profile": result.cluster.profile,
        "region": result.cluster.region,
        "namespace": result.context.namespace,
        "state": result.state,
        "notes": result.notes,
        "probe": result.probe,
        "probe_detail": result.probe_detail,
    }


STATE_MARK = {"ok": ("✓", green), "stale": ("!", yellow), "missing": ("✗", red)}
PROBE_MARK = {
    "up": ("up", green),
    "auth": ("auth", yellow),
    "down": ("down", red),
    "timeout": ("timeout", red),
    "skipped": ("-", dim),
}


def print_status_table(
    results: Sequence[Status],
    kubeconfig: Path,
    doc: dict[str, Any],
    tracked: set[str],
    args: argparse.Namespace,
) -> None:
    print(f"{bold('kubeconfig')} {kubeconfig}")
    if not results:
        print(dim("  no clusters matched"))
        return

    width_ctx = max(len(r.context.name) for r in results)
    width_profile = max(len(r.cluster.profile) for r in results)
    current = doc.get("current-context")

    for result in sorted(results, key=lambda r: r.context.name):
        mark, colour = STATE_MARK[result.state]
        marker = "*" if result.context.name == current else " "
        line = (
            f" {marker}{colour(mark)} {result.context.name:<{width_ctx}}"
            f"  {dim(result.cluster.profile.ljust(width_profile))}  {result.cluster.name}"
        )
        if result.probe:
            label, probe_colour = PROBE_MARK.get(result.probe, (result.probe, dim))
            detail = f" {result.probe_detail}" if result.probe_detail and result.probe == "up" else ""
            line += f"  {probe_colour(f'[{label}]')}{dim(detail)}"
        print(line)
        for note in result.notes:
            print(f"      {yellow('·')} {note}")
        if result.probe in {"auth", "down", "timeout"} and result.probe_detail:
            print(f"      {red('·')} {result.probe_detail}")

    if not args.quiet:
        orphans, untracked = [], []
        for entry in doc["contexts"]:
            name = entry.get("name", "")
            if name in tracked:
                continue
            if has_marker(entry.get("context")):
                orphans.append(name)  # we made it, the config dropped it -- `sync` will remove it
            elif (user := by_name(doc["users"], (entry.get("context") or {}).get("user", ""))) and is_eks_user(user):
                untracked.append(name)
        if orphans:
            print(f"\n{yellow('managed but dropped from config')} — `{PROG} sync` removes these:")
            for name in sorted(orphans):
                print(f"  {yellow('-')} {name}")
        if untracked:
            print(f"\n{dim('untracked EKS contexts (not created by this tool):')}")
            for name in sorted(untracked):
                print(f"  {dim('·')} {name}")


# --------------------------------------------------------------------------- discover


@dataclass
class Found:
    profile: str
    region: str
    name: str


def list_clusters(profile: str, region: str) -> list[str]:
    out = run_aws(["eks", "list-clusters", "--region", region, "--profile", profile, "--output", "json"])
    return list(json.loads(out).get("clusters") or [])


def pick_profiles(args: argparse.Namespace, config: Config, settings: dict[str, dict[str, str]]) -> list[str]:
    if args.profile:
        matched = [p for p in settings if any(fnmatch.fnmatch(p, s) for s in args.profile)]
        if not matched:
            die(f"no AWS profiles matched: {', '.join(args.profile)}")
        return sorted(matched)

    candidates = config.discover_profiles or sorted(settings)
    if args.all_profiles:
        return sorted(candidates)

    # One profile per AWS account -- scanning every role in an account is redundant.
    per_account: dict[str, str] = {}
    loose: list[str] = []
    for name in sorted(candidates):
        account = profile_account(settings.get(name, {}))
        if account is None:
            loose.append(name)
            continue
        current = per_account.get(account)
        if current is None or profile_rank(name) < profile_rank(current):
            per_account[account] = name
    return sorted([*per_account.values(), *loose])


def cmd_discover(args: argparse.Namespace, config: Config) -> int:
    settings = aws_profiles()
    if not settings:
        die("no AWS profiles found (~/.aws/config)")
    profiles = pick_profiles(args, config, settings)
    regions = args.region or config.discover_regions
    if not regions:
        die("no regions to scan (pass --region or set defaults.region / discover.regions)")

    known = {(c.region, c.name) for c in config.clusters}
    pairs = [(p, r) for p in profiles for r in regions]
    print(
        f"{bold('scanning')} {len(profiles)} profile(s) x {len(regions)} region(s)",
        file=sys.stderr,
    )

    found: list[Found] = []
    expired: list[str] = []
    errors: list[tuple[str, str, str]] = []
    with futures.ThreadPoolExecutor(max_workers=max(1, args.jobs)) as pool:
        pending = {pool.submit(list_clusters, p, r): (p, r) for p, r in pairs}
        for future in futures.as_completed(pending):
            profile, region = pending[future]
            try:
                names = future.result()
            except AwsError as exc:
                (expired.append(profile) if exc.needs_login else errors.append((profile, region, str(exc))))
                continue
            found.extend(Found(profile, region, name) for name in names)

    # One row per cluster; prefer the best-ranked profile that can see it.
    best: dict[tuple[str, str], Found] = {}
    for item in found:
        key = (item.region, item.name)
        if key not in best or profile_rank(item.profile) < profile_rank(best[key].profile):
            best[key] = item

    excluded = {k: v for k, v in best.items() if any(fnmatch.fnmatch(v.name, pat) for pat in config.discover_exclude)}
    new = sorted(
        (v for k, v in best.items() if k not in known and k not in excluded),
        key=lambda f: (f.region, f.name),
    )
    seen = sorted((v for k, v in best.items() if k in known), key=lambda f: (f.region, f.name))

    if args.json:
        print(
            json.dumps(
                {
                    "new": [vars(f) for f in new],
                    "known": [vars(f) for f in seen],
                    "excluded": [vars(f) for f in excluded.values()],
                    "login_required": sorted(set(expired)),
                    "errors": [{"profile": p, "region": r, "error": e} for p, r, e in errors],
                },
                indent=2,
            )
        )
    else:
        if args.all and seen:
            print(f"{bold('already in config')} ({config.path.name})")
            for item in seen:
                print(f"  {green('✓')} {item.name} {dim(f'[{item.region}] {item.profile}')}")
            print()
        if excluded and args.all:
            print(f"{bold('excluded by config')}")
            for item in excluded.values():
                print(f"  {dim('·')} {item.name} {dim(f'[{item.region}]')}")
            print()
        if not new:
            print(f"{green('no new clusters')} — {len(seen)} of {len(best)} already tracked")
        else:
            print(f"{bold('new clusters')} ({len(new)}) — add to {config.path}:\n")
            print(render_snippet(new))

    if expired:
        print(
            f"\n{yellow('skipped')} {len(set(expired))} profile(s) needing login: "
            f"{', '.join(sorted(set(expired))[:6])}"
            f"\n  {sso_login_hint(set(expired), settings)}",
            file=sys.stderr,
        )
    for profile, region, message in errors:
        print(f"{dim(f'{profile} [{region}]')}: {message}", file=sys.stderr)

    return EXIT_PROBLEM if new else EXIT_OK


def render_snippet(new: Sequence[Found]) -> str:
    lines = ["clusters:"]
    for item in new:
        lines += [
            f"  - name: {item.name}",
            f"    profile: {item.profile}",
            f"    region: {item.region}",
            f"    contexts: [{item.name}]",
        ]
    return "\n".join(lines)


# --------------------------------------------------------------------------- cli


def common_args(suppress: bool) -> argparse.ArgumentParser:
    """Options accepted before *and* after the subcommand.

    The subparser copies use SUPPRESS so an unset flag leaves whatever the
    top-level parser already stored, instead of clobbering it with a default.
    """

    def default(value: Any) -> Any:
        return argparse.SUPPRESS if suppress else value

    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-c", "--config", type=Path, metavar="FILE", default=default(None), help="cluster config (YAML)")
    parser.add_argument(
        "-k", "--kubeconfig", type=Path, metavar="FILE", default=default(None), help="kubeconfig to read/write"
    )
    parser.add_argument("-j", "--jobs", type=int, metavar="N", default=default(8), help="parallel workers (default: 8)")
    return parser


def build_parser() -> argparse.ArgumentParser:
    common = common_args(suppress=True)

    filters = argparse.ArgumentParser(add_help=False)
    filters.add_argument("selector", nargs="*", help="cluster or context name globs (default: all)")
    filters.add_argument("-p", "--profile", action="append", default=[], metavar="GLOB", help="filter by AWS profile")

    parser = argparse.ArgumentParser(
        prog=PROG,
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        parents=[common_args(suppress=False)],
    )
    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser(
        "status", parents=[common, filters], help="check kubeconfig entries against the config"
    )
    status.add_argument("--probe", action="store_true", help="also call each API server via kubectl")
    status.add_argument("--timeout", type=int, default=10, metavar="SEC", help="probe timeout (default: 10)")
    status.add_argument("--json", action="store_true", help="machine-readable output")
    status.add_argument("-q", "--quiet", action="store_true", help="hide untracked contexts")
    status.set_defaults(func=cmd_status)

    sync = sub.add_parser("sync", parents=[common, filters], help="make the kubeconfig match the config")
    sync.add_argument("-n", "--dry-run", action="store_true", help="print a diff instead of writing")
    sync.add_argument("-y", "--yes", action="store_true", help="do not prompt before removing contexts")
    sync.add_argument("--no-prune", dest="prune", action="store_false", help="keep contexts dropped from the config")
    sync.add_argument(
        "--prune-untracked",
        action="store_true",
        help="also offer to remove EKS contexts this tool never created",
    )
    sync.add_argument("--no-backup", dest="backup", action="store_false", help="skip the .bak copy")
    sync.add_argument("--set-current", metavar="CONTEXT", help="set current-context after syncing")
    sync.set_defaults(func=cmd_sync, backup=True, prune=True)

    discover = sub.add_parser("discover", parents=[common], help="find EKS clusters missing from the config")
    discover.add_argument("-p", "--profile", action="append", default=[], metavar="GLOB", help="profiles to scan")
    discover.add_argument("-r", "--region", action="append", default=[], metavar="REGION", help="regions to scan")
    discover.add_argument("--all-profiles", action="store_true", help="scan every profile, not one per account")
    discover.add_argument("-a", "--all", action="store_true", help="also list clusters already in the config")
    discover.add_argument("--json", action="store_true", help="machine-readable output")
    discover.set_defaults(func=cmd_discover)

    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        config = load_config(find_config(args.config))
    except ConfigError as exc:
        die(str(exc))
        raise AssertionError
    try:
        return args.func(args, config)
    except AwsError as exc:
        die(str(exc))
        raise AssertionError
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
