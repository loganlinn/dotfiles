"""Look up, focus, resume, or preview a Codex/Claude session."""

from pathlib import Path
import runpy

if __name__ == "__main__":
    module = Path(__file__).resolve().parents[1] / "config/kitty/agent_session.py"
    runpy.run_path(str(module), run_name="__main__")
