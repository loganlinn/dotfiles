#!/usr/bin/env python3
"""Render Markdown files and directories in a browser.

In Zsh, `alias -s md=mdpreview` previews a file entered as a command.
"""

import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))

from mdpreview.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
