#!/usr/bin/env -S mise x uv -- uv run --script
# /// script
# requires-python = ">=3.12"
# ///
"""Publish local text documents to external targets. GitHub Gist is the
first target.

``pub <file>`` is an idempotent upsert: the first run creates a secret
gist, writes an ``x-pub:`` comment tag into the file, and prints the URL.
Every later run syncs the file to the same gist. The tag is the durable
link between the file and its published copy.

Gist "secret" means unlisted, not private. Visibility is immutable after
creation: ``--public`` applies at creation only, and a visibility change
means recreating the gist.

JSON output uses this envelope:

    {"ok": true, "command": "...", "data": {...}}
    {"ok": false, "error": {"code": "...", "message": "..."}}
"""

from __future__ import annotations

import argparse
import contextlib
import datetime as dt
import difflib
import fcntl
import fnmatch
import hashlib
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import urllib.parse
import webbrowser
from dataclasses import dataclass
from pathlib import Path
from typing import Any, ClassVar, Iterator, Protocol, Sequence

