#!/usr/bin/env bash
# Print the raw evidence for every failed check on a PR, as markdown.
# Evidence only — no instructions. Pipe it into an agent to get a diagnosis.
# Usage: gh-fails [<pr>] [-n <log-lines-per-job>]
set -euo pipefail

pr=""
tail_lines="${GH_FAILS_LINES:-150}"
while [[ $# -gt 0 ]]; do
	case "$1" in
	-n)
		tail_lines="$2"
		shift 2
		;;
	*)
		pr="$1"
		shift
		;;
	esac
done

# Turn a raw Actions job log into the part a human would actually read.
clean_log() {
	sed -E $'s/^[^\t]*\t[^\t]*\t//' |                                          # drop job/step columns
		sed -E $'s/^\xef\xbb\xbf//; s/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z //' | # drop BOM + timestamp
		{ grep -v '\[36;1m' || true; } |                                          # drop the echoed "Run:" script block
		sed -E $'s/(\x1b|\\^\\[)\\[[0-9;]*[A-Za-z]//g' |                          # drop ANSI colour codes
		sed -E '/^(Post job cleanup\.|Cleaning up orphan processes)/,$d'          # drop teardown noise
}

# The real cause usually sits above an ##[error] marker, not at the end of the
# log, so window around the markers and fall back to the tail only if there
# are none.
focus_errors() {
	local body
	body=$(cat)
	if grep -qF '##[error]' <<<"$body"; then
		grep -F -B 20 -A 2 '##[error]' <<<"$body" | tail -n "$tail_lines"
	else
		tail -n "$tail_lines" <<<"$body"
	fi
}

meta=$(gh pr view ${pr:+"$pr"} --json url,title,headRefName,headRefOid)
pr_sha=$(jq -r .headRefOid <<<"$meta")
pr_branch=$(jq -r .headRefName <<<"$meta")
local_sha=$(git rev-parse HEAD 2>/dev/null || true)
local_branch=$(git branch --show-current 2>/dev/null || true)
failed=$(gh pr checks ${pr:+"$pr"} --json name,state,bucket,link,workflow \
	--jq '[.[] | select(.bucket=="fail")]')

[[ $(jq length <<<"$failed") -gt 0 ]] || {
	echo >&2 "no failed checks"
	exit 1
}

jq -r '"# CI failures: \(.title)\n\n<\(.url)> (branch `\(.headRefName)`)"' <<<"$meta"
echo

jq -r '.[] | [.name, .workflow, .link] | @tsv' <<<"$failed" |
	while IFS=$'\t' read -r name workflow link; do
		echo "## ${workflow:-external} / $name"
		echo "<$link>"
		echo

		if [[ "$link" =~ /actions/runs/([0-9]+)/job/([0-9]+) ]]; then
			run="${BASH_REMATCH[1]}" job="${BASH_REMATCH[2]}"

			# A failure can belong to an older commit than the PR head, or to a
			# commit you no longer have checked out. Say so, or the agent will
			# happily "fix" something that is already fixed.
			run_sha=$(gh run view "$run" --json headSha --jq .headSha 2>/dev/null || true)
			if [[ -n "$run_sha" && "$run_sha" != "$pr_sha" ]]; then
				echo "> STALE: this run is for \`${run_sha:0:10}\`, PR head is \`${pr_sha:0:10}\`."
				echo "> A newer run may already have fixed it."
				echo
			elif [[ "$local_branch" == "$pr_branch" && -n "$local_sha" && "$local_sha" != "$run_sha" ]]; then
				echo "> LOCAL DRIFT: you are on \`${local_sha:0:10}\`, this run is for \`${run_sha:0:10}\`."
				echo
			fi

			log=$(gh run view "$run" --job "$job" --log-failed 2>/dev/null || true)
			[[ -n "$log" ]] || log=$(gh run view "$run" --job "$job" --log 2>/dev/null || true)
			echo '```'
			printf '%s\n' "$log" | clean_log | focus_errors
			echo '```'
		else
			echo "_Not a GitHub Actions check — see the link._"
		fi
		echo
	done
